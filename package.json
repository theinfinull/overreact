{
    "name": "overreact",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "build": "babel src --out-dir dist --extensions .js,.jsx",
        "watch": "babel src --out-dir dist --extensions .js,.jsx --watch",
        "dev": "npx --yes concurrently -k \"npm run watch\" \"npx --yes serve .\"",
        "lint": "oxlint"
    },
    "devDependencies": {
        "@babel/cli": "^7.28.3",
        "@babel/core": "^7.28.3",
        "@babel/preset-react": "^7.27.1",
        "oxlint": "^1.79.0"
    }
}
